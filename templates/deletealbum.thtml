<span class="mg-fw-bold">{lang_edit_title}</span>
<form method="post" action="{s_form_action}" class="uk-form">
<div>
<input type="hidden" name="album_id" value="{album_id}">
<input type="hidden" name="action" value="confalbum">
<input type="hidden" name="{gltoken_name}" value="{gltoken}">
<table cellpadding="3" cellspacing="1" border="0">
  <tr>
    <td class="mg-w-15 mg-text-right">
      <span class="mg-fw-bold">{lang_title}</span>
    </td>
    <td colspan="2">{album_title}</td>
  </tr>
  <tr>
    <td class="mg-w-15 mg-text-right"><span class="mg-fw-bold">{lang_description}</span></td>
    <td colspan="2" rowspan="3" class="mg-valign-top">{album_desc}</td>
  </tr>
  <tr><td colspan="3">&nbsp;</td></tr>
  <tr><td colspan="3">&nbsp;</td></tr>
  <tr>
    <td class="mg-w-15 mg-text-right"><span class="mg-fw-bold">{lang_move_all_media}</span></td>
    <td colspan="2">{select_destination}</td>
  </tr>
  <tr>
    <td colspan="2" class="mg-text-center">
      <input type="submit" name="mode" value={lang_delete}{xhtml}>
      <input type="submit" name="mode" value={lang_cancel}{xhtml}>
    </td>
  </tr>
</table>
</div>
</form>