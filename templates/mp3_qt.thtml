<!doctype html>
<html>
<head>
<meta charset="{charset}">
{themeCSS}
<title>{title}</title>
</head>
<body>
<div class="mg-audio-player mg-audio-player-popup">
  {u_pic}
  <audio controls preload="metadata" style="max-width:100%;width:{width}px;">
    <source src="{movie}">
    <a href="{movie}">{title}</a>
  </audio>
</div>
</body>
</html>
