<section class="mg-featured-album">
  <h2>{featured_album}</h2>
  <div class="mg-featured-album-grid">
    <div class="mg-featured-album-thumb" style="max-width:{column_width}px;">
      {media_item_thumbnail}
    </div>
    <div class="mg-featured-album-summary">
      <p class="mg-featured-album-line"><strong>{album_title}</strong> ({subalbum_media_count})</p>
      <div class="mg-featured-album-description">{album_desc}</div>
      <p class="mg-featured-album-line"><strong>{updated_prompt}</strong> {album_last_update}</p>
    </div>
    <div class="mg-featured-album-subalbums">
      <p class="mg-featured-album-line"><strong>{lang_subalbums}</strong> {subalbumcount}</p>
      <div class="mg-featured-album-list">{saulstart}{subalbumlist}{saulend}</div>
    </div>
  </div>
</section>
