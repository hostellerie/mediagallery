<div class="mg-playall">
  <header class="mg-playall-header">
    <h1>{album_title}</h1>
    <div class="mg-playall-pagination">{pagination}</div>
  </header>
  <div class="mg-playall-content">
    <p>{album_desc}</p>
    <p><a href="{site_url}/album.php?aid={aid}">Open this MediaGallery album</a></p>
    <p><a href="{site_url}/xspf.php?aid={aid}">Download the XSPF playlist</a></p>
  </div>
</div>
