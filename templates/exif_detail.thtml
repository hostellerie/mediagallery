<fieldset class="mg-mb-xs">
  <legend>{exif_title}</legend>
  <table class="mg_exif_table">
  <!-- BEGIN exifRow -->
    <tr>
    <!-- BEGIN exifColumn -->
      <td class="mg-fw-bold mg-w-quarter mg-text-right">{label}:</td>
      <td class="mg-w-quarter">{value}</td>
    <!-- END exifColumn -->
    </tr>
  <!-- END exifRow -->
  </table>
</fieldset>
