<article class="mg_album_item">
<div class="mg_thumbnail" style="height:{row_height}px">
  <div class="mg_thumbnail_wrapper">{media_item_thumbnail}</div>
</div>

<div class="mg_album_item_title"><strong>{lang_album} {album_title}</strong> ({subalbum_media_count})</div>

<div class="pluginSmallText">{album_desc}</div>

{!if updated}
<div class="pluginSmallText"><strong>{updated}</strong> {album_last_update}</div>
{!endif}

{!if lang_views}
<div class="pluginSmallText"><strong>{lang_views}</strong> {views}</div>
{!endif}

{!if lang_subalbums}
<div class="pluginSmallText"><strong>{lang_subalbums}</strong> {subalbumcount}</div>
{!endif}
</article>
