<fieldset class="mg-playback-dimensions">
  <legend>{lang_playback_options}</legend>
  <input type="hidden" name="playback_geometry" value="1"{xhtml}>
  <dl class="form_block">
    <dt><label for="mg-playback-width">{lang_width}</label></dt>
    <dd><input type="number" id="mg-playback-width" name="width" value="{width}" min="1" step="1" inputmode="numeric"{xhtml}> <span class="description">{lang_width_help}</span></dd>
    <dt><label for="mg-playback-height">{lang_height}</label></dt>
    <dd><input type="number" id="mg-playback-height" name="height" value="{height}" min="1" step="1" inputmode="numeric"{xhtml}> <span class="description">{lang_height_help}</span></dd>
  </dl>
</fieldset>
