<div class="mg_album_header">
  <div class="mg_album_title"><strong>{album_title}</strong></div>
  <div class="mg_search">{pagination}</div>
</div>
<!-- BEGIN noItems -->
<div style="text-align:center">
  {no_images}
</div>
<!-- END noItems -->
<!-- BEGIN slideItems -->
<script type="text/javascript">
//<![CDATA[
var timer;
var current_location = 1;
var next_location = 1;
var pics_loaded = 0;
var onoff = 0;
var direction = 1;
var timeout_value;
var images = new Array;
var photo_urls = new Array;
var photo_captions = new Array;
var loop = 0;

{photo_info}

var photo_count = {photo_count};

function stopOrStart() {
    if (onoff) {
        stop();
    } else {
        play();
    }
}

function toggleLoop() {
    loop = document.getElementById('slideshowLoop').checked ? 1 : 0;
}

function changeElementText(id, newText) {
    var element = document.getElementById(id);
    if (element) {
        element.innerHTML = newText;
    }
}

function stop() {
    changeElementText('stopOrStartText', '{play}');
    onoff = 0;
    status = '{ss_stopped}';
    clearTimeout(timer);
}

function play() {
    changeElementText('stopOrStartText', '{stop}');
    onoff = 1;
    status = '{ss_running}';
    go_to_next_photo();
}

function changeDirection() {
    if (direction == 1) {
        direction = -1;
        changeElementText('changeDirText', '{forward}');
    } else {
        direction = 1;
        changeElementText('changeDirText', '{reverse}');
    }
    preload_next_photo();
}

function preload_complete() {
}

function reset_timer() {
    clearTimeout(timer);
    if (onoff) {
        var delay = document.getElementById('slideshowDelay');
        timeout_value = delay.options[delay.selectedIndex].value * 1000;
        timer = setTimeout(go_to_next_photo, timeout_value);
    }
}

function wait_for_current_photo() {
    if (!show_current_photo()) {
        status = '{picture_loading}(' + current_location + ' {lang_of} ' + photo_count +
                ').  {please_wait}';
        clearTimeout(timer);
        timer = setTimeout(wait_for_current_photo, 500);
        return 0;
    }

    status = '{ss_running}';
    preload_next_photo();
    reset_timer();
}

function go_to_next_photo() {
    current_location = next_location;

    if (!show_current_photo()) {
        wait_for_current_photo();
        return 0;
    }
    preload_next_photo();
    reset_timer();
}

function preload_next_photo() {
    next_location = parseInt(current_location, 10) + parseInt(direction, 10);
    if (next_location > photo_count) {
        next_location = 1;
        if (!loop) {
            stop();
        }
    }
    if (next_location == 0) {
        next_location = photo_count;
        if (!loop) {
            stop();
        }
    }
    preload_photo(next_location);
}

function show_current_photo() {
    if (!images[current_location] || !images[current_location].complete) {
        preload_photo(current_location);
        return 0;
    }

    var slide = document.getElementById('slide');
    if (slide) {
        slide.src = images[current_location].src;
    }
    setCaption(photo_captions[current_location]);
    return 1;
}

function preload_photo(index) {
    if (pics_loaded < photo_count && !images[index]) {
        images[index] = new Image();
        images[index].onload = preload_complete;
        images[index].src = photo_urls[index];
        pics_loaded++;
    }
}

function setCaption(text) {
    changeElementText('caption', '[' + current_location + ' {lang_of} ' + photo_count + '] ' + text);
}
//]]>
</script>

<form name="TopForm" id="TopForm" action="" class="uk-form">
  <div class="mg_navbar" style="text-align:center">
    <button type="button" onclick="stopOrStart();"><span id="stopOrStartText">{play}</span></button>
    &nbsp;&nbsp;|&nbsp;&nbsp;{full_toggle}&nbsp;&nbsp;|&nbsp;&nbsp;
    <label for="slideshowDelay">{delay}:</label>
    <select id="slideshowDelay" name="time" size="1" onchange="reset_timer()">
      <option value="1">1 {seconds}</option>
      <option value="2">2 {seconds}</option>
      <option value="3" selected="selected">3 {seconds}</option>
      <option value="4">4 {seconds}</option>
      <option value="5">5 {seconds}</option>
      <option value="10">10 {seconds}</option>
      <option value="15">15 {seconds}</option>
      <option value="30">30 {seconds}</option>
      <option value="45">45 {seconds}</option>
      <option value="60">60 {seconds}</option>
    </select>
    &nbsp;|&nbsp;&nbsp;
    <input type="checkbox" id="slideshowLoop" name="loopCheck" onclick="toggleLoop();"{xhtml}>
    <label for="slideshowLoop">{loop}</label>
  </div>

  <div class="mg_media_detail">
    <div class="mgFrame_default">
      <img id="slide" name="slide" src="" alt="" style="max-width:{max_image_width}px;"{xhtml}>
    </div>
  </div>

  <div class="mg_navbar" style="text-align:center">
    <div id="caption" aria-live="polite"></div>
  </div>

  <script type="text/javascript">
  //<![CDATA[
  var slide = document.getElementById('slide');
  if (slide && photo_urls[1]) {
      slide.src = photo_urls[1];
  }
  setCaption(photo_captions[1]);
  preload_photo(1);
{!if using_jquery}
  $(window).load(function() {
{!else}
  window.addEvent('load', function () {
{!endif}
      changeElementText('stopOrStartText', '{stop}');
      onoff = 1;
      status = '{ss_running}';
      go_to_next_photo();
  });
  //]]>
  </script>
</form>
<!-- END slideItems -->
<!-- BEGIN photo_url -->
{URL}
{CAPTION}
<!-- END photo_url -->
