<div class="mg-fslideshow-legacy" id="{id}" style="max-width:{width}px;min-height:2.5em;">
  <a id="{id2}" href="{site_url}/index.php">Open slideshow</a>
</div>
<script type="text/javascript">
(function () {
    var source = '{movie}';
    var match = source.match(/[?&]aid=([^%&]+)/);
    var link = document.getElementById('{id2}');
    if (match && link) {
        link.href = '{site_url}/slideshow.php?aid=' + encodeURIComponent(match[1]);
    }
}());
</script>
