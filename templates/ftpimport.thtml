{start_block}
{navbar}
<script type="text/javascript">
function doCheckAll_ftpinput()
{
  var form = document.forms.mediaupload;
  if (!form) {
    return;
  }
  for (var i = 0; i < form.elements.length; i++) {
    if (form.elements[i].type === 'checkbox') {
      form.elements[i].checked = true;
    }
  }
}

function doUnCheckAll_ftpinput()
{
  var form = document.forms.mediaupload;
  if (!form) {
    return;
  }
  for (var i = 0; i < form.elements.length; i++) {
    if (form.elements[i].type === 'checkbox') {
      form.elements[i].checked = false;
    }
  }
}
</script>
<p>{lang_ftp_help}</p>
<form method="post" enctype="multipart/form-data" name="mediaupload" action="{s_form_action}" class="uk-form">
  <div>
    <input type="hidden" name="action" value="{action}"{xhtml}>
    <input type="hidden" name="album_id" value="{album_id}"{xhtml}>
    <input type="hidden" name="purgefiles" value="{purgefiles}"{xhtml}>
    <input type="hidden" name="{gltoken_name}" value="{gltoken}"{xhtml}>
    <table class="uk-table uk-table-small" style="width:100%;text-align:left;">
      <tr>
        <th class="pluginCellTitle" style="text-align:center;">{lang_filelist}</th>
      </tr>
      <tr>
        <td>{filelist}</td>
      </tr>
      <tr>
        <td>
          <input onclick="doCheckAll_ftpinput()" type="button" value="{lang_checkall}"{xhtml}>
          <input onclick="doUnCheckAll_ftpinput()" type="button" value="{lang_uncheckall}"{xhtml}>
        </td>
      </tr>
      <tr>
        <td style="text-align:center;">
          <input type="submit" value="{lang_save}" name="mode"{xhtml}>
          <input type="submit" value="{lang_cancel}" name="mode"{xhtml}>
        </td>
      </tr>
    </table>
  </div>
</form>
{end_block}
