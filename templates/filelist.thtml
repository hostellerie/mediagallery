<table class="mg_admin_table">
<!-- BEGIN dirRow -->
<tr>
  <th colspan="3" class="mg-w-full">
    <span class="mg-fw-bold">{lang_put_files}</span>&nbsp;{directory}&nbsp;<span class="mg-fw-bold">{lang_into_album}</span>&nbsp;
  </th>
  <td>
    {destination}
  </td>
</tr>
<!-- END dirRow -->
<!-- BEGIN fileRow -->
<tr>
<td class="mg-w-10">
  {checkbox}
  {palbum}
  {pfile}
</td>
<td>{color}{filename}</span>
</td>
<td> {type} </td>
<td class="mg-text-right">{filesize}</td>
</tr>
<!-- END fileRow -->
</table>