<script type="text/javascript">
<!--
function doCheckAll_mediaitems() {
  with (document.media) {
    for (var i=0; i < elements.length; i++) {
      if (elements[i].type == 'checkbox' && elements[i].name == 'sel[]')
        elements[i].checked = true;
    }
  }
}

function doUnCheckAll_mediaitems() {
  with (document.media) {
    for (var i=0; i < elements.length; i++) {
      if (elements[i].type == 'checkbox' && elements[i].name == 'sel[]')
        elements[i].checked = false;
    }
  }
}
// End script --></script>

<table class="mg_mediaitems_table">
  <tr>
    <th scope="col">{lang_select}</th>
    <th scope="col">{lang_item}</th>
    <th scope="col">{lang_watermarked}</th>
    <th scope="col">{lang_order}</th>
    <th scope="col">{lang_cover}</th>
    <th scope="col">{lang_include_ss}</th>
    <th scope="col" class="mg-text-left">{lang_title}/{lang_description}/{lang_keywords}</th>
  </tr>
  <tr>
    <td colspan="7" class="mg-text-center">
      <input type="radio" id="mg-reset-cover" name="cover" value="-2"{val_reset_cover}{xhtml}>&nbsp;&nbsp;<label for="mg-reset-cover">{lang_reset_cover}</label>
    </td>
  </tr>
  <!-- BEGIN ImageRow -->
  <!-- BEGIN ImageColumn -->
  <tr>
    <td class="mg-valign-middle mg-text-center">
      <input type="checkbox" id="mg-media-select-{counter}" name="sel[]" value="{mid}" aria-label="{lang_select}"{xhtml}>
      <input type="hidden" name="mid[]" value="{mid}"{xhtml}>
    </td>
    <td class="mg-valign-middle mg-text-center">
      {media_zoom}<img src="{u_thumbnail}" height="{height}" width="{width}" alt="{media_title}" loading="lazy" decoding="async"{xhtml}></a>
      <br{xhtml}><a href="{media_edit}">{lang_edit}</a>
    </td>
    <td class="mg-valign-middle mg-text-center">
      {watermarked}
    </td>
    <td class="mg-valign-middle mg-text-center">
      <input type="number" id="mg-media-order-{counter}" name="seq[]" value="{order}" size="3" inputmode="numeric" aria-label="{lang_order}"{xhtml}>
      <input type="hidden" name="oldseq[]" value="{order}"{xhtml}>
    </td>
    <td class="mg-valign-middle mg-text-center">
      {radio_box}
    </td>
    <td class="mg-valign-middle mg-text-center">
      {include_ss}
    </td>
    <td class="mg-valign-middle">
      <div class="mg-media-manager-field"><label for="mg-media-title-{counter}">{lang_title}</label><br{xhtml}><input type="text" id="mg-media-title-{counter}" name="mtitle[]" value="{media_title}" size="30" class="mg-media-manager-input"{xhtml}></div>
      <label for="mg-media-desc-{counter}">{lang_description}</label><br{xhtml}><textarea id="mg-media-desc-{counter}" name="mdesc[]" cols="40" rows="2" class="mg-media-manager-textarea">{media_desc}</textarea><br{xhtml}>
      <div class="mg-media-manager-field"><label for="mg-media-keywords-{counter}">{lang_keywords}</label><br{xhtml}><input type="text" id="mg-media-keywords-{counter}" name="mkeywords[]" value="{media_keywords}" size="30" class="mg-media-manager-input"{xhtml}></div>
      <div class="mg-media-manager-category"><label for="mg-media-category-{counter}">{lang_category}</label>:&nbsp;{cat_select}</div>
    </td>
  </tr>
  <!-- END ImageColumn -->
  <!-- END ImageRow -->
</table>

<div class="mg-admin-action-row">
  <input onclick="doCheckAll_mediaitems()" type="button" value="{lang_checkall}"{xhtml}>
  <input onclick="doUnCheckAll_mediaitems()" type="button" value="{lang_uncheckall}"{xhtml}>
</div>

<div class="mg-admin-action-row">
  <label for="mg-media-destination-album">{lang_albumsel}</label>&nbsp;&nbsp;{albumselect}&nbsp;<input type="submit" name="mode" value="{lang_move}"{xhtml}>
</div>

<div class="mg-admin-action-row">
  <label for="mg-media-batch-option">{lang_batch_options}</label>&nbsp;&nbsp;{batchoptionselect}&nbsp;<input type="submit" name="mode" value="{lang_batch}"{xhtml}>
</div>
