<form name="quotareport" action="{site_admin_url}/quotareport.php" method="post" class="uk-form">
  <div class="mg-mb-sm">
    {lang_quota} &gt;=&nbsp;<input type="text" name="quota" value="{quota}" size="3"{xhtml}>&nbsp;Mb&nbsp;
    <input type="submit" value="{lang_go}" name="go"{xhtml}>
  </div>
</form>
<form name="quotaedit" action="{site_admin_url}/quotareport.php" method="post" class="uk-form">
  <table class="mg_admin_table">
    <tr>
      <th class="mg-select-column">{lang_select}</th>
      <th>{lang_username}</th>
      <th>{lang_active}</th>
      <th>{lang_quota}</th>
      <th>{lang_used}</th>
    </tr>
    <!-- BEGIN UserRow -->
    <tr>
      <td class="mg-text-left"><input type="checkbox" value="{uid}" name="uid[]"{xhtml}></td>
      <td class="mg-text-left">{username}</td>
      <td class="mg-text-center">{active}</td>
      <td class="mg-text-right">{quota}</td>
      <td class="mg-text-right">{used}</td>
    </tr>
    <!-- END UserRow -->
  </table>
  <div class="mg_submit">
    {lang_batch_update} <input type="text" size="3" name="bquota" value=""{xhtml}>&nbsp;Mb&nbsp;
    <input type="submit" value="{lang_update}" name="mode"{xhtml}>
  </div>
</form>
<div class="mg-text-center">{pagenav}</div>
