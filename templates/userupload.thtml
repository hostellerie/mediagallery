{start_block}
{navbar}
<p>{lang_upload_help}</p>
<p>{lang_upload_size}</p>
<form method="post" enctype="multipart/form-data" name="mediaupload" action="{s_form_action}" class="compact uk-form">
<div>
  <p>
    {max_file_size}
    <input type="hidden" name="action" value="{action}"{xhtml}>
    <input type="hidden" name="{gltoken_name}" value="{gltoken}"{xhtml}>
    <span style="font-weight:bold;">{lang_destination_album}</span>&nbsp;{album_select}
  </p>

  <fieldset>
    <legend>{lang_file_number}1</legend>
    <dl class="form_block">
      <dt><label>{lang_file}</label></dt>
      <dd><input type="file" name="newmedia[0]"{xhtml}></dd>

      <dt><label>{lang_do_not_convert_orig}</label></dt>
      <dd><input type="checkbox" name="dnc[0]" value="1"{xhtml}></dd>

      <dt><label>{lang_attached_tn}</label></dt>
      <dd><input type="checkbox" name="attachtn[0]" value="1"{xhtml}> <input type="file" name="thumbnail[0]"{xhtml}></dd>

      <dt><label>{lang_caption}</label></dt>
      <dd><input type="text" name="caption[0]" class="size6" value=""{xhtml}></dd>

      <dt><label>{lang_description}</label></dt>
      <dd><textarea name="description[0]" cols="60" rows="2" class="size6"></textarea></dd>

      <dt><label>{lang_keywords}</label></dt>
      <dd><input type="text" name="keywords[0]" class="size6" value=""{xhtml}></dd>

      <dt><label>{lang_category}</label></dt>
      <dd>{cat_select_0}</dd>
    </dl>
  </fieldset>

  <fieldset>
    <legend>{lang_file_number}2</legend>
    <dl class="form_block">
      <dt><label>{lang_file}</label></dt>
      <dd><input type="file" name="newmedia[1]"{xhtml}></dd>

      <dt><label>{lang_do_not_convert_orig}</label></dt>
      <dd><input type="checkbox" name="dnc[1]" value="1"{xhtml}></dd>

      <dt><label>{lang_attached_tn}</label></dt>
      <dd><input type="checkbox" name="attachtn[1]" value="1"{xhtml}> <input type="file" name="thumbnail[1]"{xhtml}></dd>

      <dt><label>{lang_caption}</label></dt>
      <dd><input type="text" name="caption[1]" class="size6" value=""{xhtml}></dd>

      <dt><label>{lang_description}</label></dt>
      <dd><textarea name="description[1]" cols="60" rows="2" class="size6"></textarea></dd>

      <dt><label>{lang_keywords}</label></dt>
      <dd><input type="text" name="keywords[1]" class="size6" value=""{xhtml}></dd>

      <dt><label>{lang_category}</label></dt>
      <dd>{cat_select_1}</dd>
    </dl>
  </fieldset>

  <fieldset>
    <legend>{lang_file_number}3</legend>
    <dl class="form_block">
      <dt><label>{lang_file}</label></dt>
      <dd><input type="file" name="newmedia[2]"{xhtml}></dd>

      <dt><label>{lang_do_not_convert_orig}</label></dt>
      <dd><input type="checkbox" name="dnc[2]" value="1"{xhtml}></dd>

      <dt><label>{lang_attached_tn}</label></dt>
      <dd><input type="checkbox" name="attachtn[2]" value="1"{xhtml}> <input type="file" name="thumbnail[2]"{xhtml}></dd>

      <dt><label>{lang_caption}</label></dt>
      <dd><input type="text" name="caption[2]" class="size6" value=""{xhtml}></dd>

      <dt><label>{lang_description}</label></dt>
      <dd><textarea name="description[2]" cols="60" rows="2" class="size6"></textarea></dd>

      <dt><label>{lang_keywords}</label></dt>
      <dd><input type="text" name="keywords[2]" class="size6" value=""{xhtml}></dd>

      <dt><label>{lang_category}</label></dt>
      <dd>{cat_select_2}</dd>
    </dl>
  </fieldset>

  <fieldset>
    <legend>{lang_file_number}4</legend>
    <dl class="form_block">
      <dt><label>{lang_file}</label></dt>
      <dd><input type="file" name="newmedia[3]"{xhtml}></dd>

      <dt><label>{lang_do_not_convert_orig}</label></dt>
      <dd><input type="checkbox" name="dnc[3]" value="1"{xhtml}></dd>

      <dt><label>{lang_attached_tn}</label></dt>
      <dd><input type="checkbox" name="attachtn[3]" value="1"{xhtml}> <input type="file" name="thumbnail[3]"{xhtml}></dd>

      <dt><label>{lang_caption}</label></dt>
      <dd><input type="text" name="caption[3]" class="size6" value=""{xhtml}></dd>

      <dt><label>{lang_description}</label></dt>
      <dd><textarea name="description[3]" cols="60" rows="2" class="size6"></textarea></dd>

      <dt><label>{lang_keywords}</label></dt>
      <dd><input type="text" name="keywords[3]" class="size6" value=""{xhtml}></dd>

      <dt><label>{lang_category}</label></dt>
      <dd>{cat_select_3}</dd>
    </dl>
  </fieldset>

  <div class="mg_submit">
    <input type="submit" value="{lang_save}" name="mode" class="submit"{xhtml}>
    <input type="submit" value="{lang_cancel}" name="mode" class="submit"{xhtml}>
  </div>
</div>
</form>
{end_block}
