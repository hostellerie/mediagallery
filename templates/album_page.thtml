{lbslideshow}
<script type="text/javascript" src="{site_url}/players/audio-player.js"></script>

<nav class="bc_navigation" aria-label="Breadcrumb">
{birdseed}
</nav>

<header class="mg_album_header">
<h1 class="mg_album_title">{album_title}{!if rsslink}&nbsp;&nbsp;{rsslink}{!endif}</h1>
<div class="mg_search">
<form name="mgsearch" method="post" action="{site_url}/search.php" class="uk-form" role="search">
<div>
  <label for="mg-search-keywords" class="mg-visually-hidden">{lang_search}</label>
  <input id="mg-search-keywords" type="search" name="keywords" value="{keywords}" aria-label="{lang_search}"{xhtml}>
  <input type="hidden" name="mode" value="search"{xhtml}>
  <input type="hidden" name="swhere" value="0"{xhtml}>
  <input type="submit" value="{lang_search}"{xhtml}>
</div>
</form>
</div>
{!if select_adminbox}
<div class="mg_adminbox">
{select_adminbox}
</div>
{!endif}
</header>

<nav class="mg_navbar" aria-label="Album actions and pagination">

  {!if url_slideshow}
  <a class="button" href="{url_slideshow}">{lang_slideshow}</a>
  {!endif}

  {!if edit_album}
  <a class="button" href="{url_edit}">{lang_edit}</a>
  {!endif}

  {!if top_pagination}
  <div class="mg_pagination">{top_pagination}</div>
  {!endif}

</nav>

{!if album_description}
<section class="mg_album_description">
   {album_description}
</section>
{!endif}

{!if album_body}
<div class="mg_album_grid" style="width:100%;margin:10px 0;clear:both">
<!-- BEGIN ImageRow -->
<!-- BEGIN ImageColumn -->
<div class="mg_album_cell" style="width:{table_column_width};{clear_float}">
{CELL_DISPLAY_IMAGE}
</div>
<!-- END ImageColumn -->
<!-- END ImageRow -->
</div>
<div style="clear:both"></div>
{!endif}

{!if lang_no_image}<div class="noitems">{lang_no_image}</div>{!endif}

<nav class="mg_navbar" aria-label="Album pagination">
  <span>{album_id_display}</span><span class="mg_separator">|</span><span>{page_number}</span>
  <div class="mg_pagination">{bottom_pagination}</div>
</nav>
<div class="mg_jumpbox">{jumpbox}</div>
<div class="mg_sortbox">{select_sortbox}</div>
