<header class="mg_album_header mg-fslideshow-header">
  <h1 class="mg_album_title">{album_title}</h1>
  {!if pagination}<nav class="mg_pagination" aria-label="Slideshow pagination">{pagination}</nav>{!endif}
</header>
<!-- BEGIN noItems -->
<div class="mg-empty-album">
  {no_images}
</div>
<!-- END noItems -->
<!-- BEGIN slideItems -->
<div class="mg-legacy-slideshow">
  <p><a class="mg-fslideshow-link" href="{site_url}/slideshow.php?aid={aid}">Open slideshow</a></p>
</div>
<!-- END slideItems -->
