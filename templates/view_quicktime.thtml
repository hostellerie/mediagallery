<div class="mg-media-player mg-media-player-video">
  <video controls preload="metadata" width="{width}" height="{height}">
    <source src="{movie}">
    <p>{lang_noquicktime} <a href="{movie}">Download {filename}</a></p>
  </video>
  <noscript><p><a href="{movie}">Download {filename}</a></p></noscript>
</div>