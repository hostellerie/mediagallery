{# begin {templatelocation} #}
<h1>{lang_album} {album_title}</h1>
<div class="mgPluginMeta">
{updated} {album_last_update}
</div>

<br{xhtml}>

<div class="mg-podcast-album-summary">
  <div class="mgPluginMI mg-podcast-album-thumb">{media_item_thumbnail}</div>
  <div class="mg-podcast-album-description">{album_desc}</div>
</div>

<div class="pluginItemFooter">
<strong>{lang_subalbums}</strong> {subalbumcount}
</div>

<hr{xhtml}>

{# end {templatelocation} #}
