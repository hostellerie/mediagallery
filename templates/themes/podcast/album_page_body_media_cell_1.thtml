{# begin {templatelocation} #}
<span id="{media_id}" class="mg-anchor-target" aria-hidden="true"></span>
<h2 class="mg-podcast-media-title mg-podcast-card-title">{media_title}</h2>
<h3 class="mg-podcast-media-subtitle mg-podcast-card-subtitle">{musicalbum} {lang_hyphen} {artist}</h3>
<div class="pluginSmallText">
 {lang_published} {media_owner} {lang_on} {media_time}
</div>
{!if media_cell_keywords}
<div class="pluginMediumText">{media_cell_keywords}</div>
{!endif}
<div class="mg-podcast-media-layout">
  <div class="mg-podcast-media-aside">
    <div class="mgPluginMI mg-podcast-media-thumb">{media_item_thumbnail}</div>
    <div class="pluginItemFooter">
      {!if media_comments}
      <div class="pluginMediumText">{media_comments}</div>
      {!endif}
      {!if media_views}
      <div class="pluginMediumText">{media_views}</div>
      {!endif}
      {!if rating_box}
      {rating_box}
      {!endif}
      {!if alt_edit_link}
      <div class="pluginSmallText">{alt_edit_link}</div>
      {!endif}
    </div>
  </div>
  <div class="mg-podcast-media-description"><p>{media_description}</p></div>
</div>
{mp3_podcast}
<hr{xhtml}>
{# end {templatelocation} #}
