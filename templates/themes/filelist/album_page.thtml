{lbslideshow}
<script type="text/javascript" src="{site_url}/players/audio-player.js"></script>

<nav class="bc_navigation" aria-label="Breadcrumb">
{birdseed}
</nav>

<header class="mg_album_header">
<h1 class="mg_album_title">{album_title}{!if rsslink}&nbsp;&nbsp;{rsslink}{!endif}</h1>
<div class="mg_search">
<form name="mgsearch" method="post" action="{site_url}/search.php" class="uk-form" role="search">
<div>
  <label for="mg-skin-search-keywords" class="mg-visually-hidden">{lang_search}</label>
  <input id="mg-skin-search-keywords" type="search" name="keywords" value="{keywords}" aria-label="{lang_search}"{xhtml}>
  <input type="hidden" name="mode" value="search"{xhtml}>
  <input type="hidden" name="swhere" value="0"{xhtml}>
  <input type="submit" value="{lang_search}"{xhtml}>
</div>
</form>
</div>
{!if select_adminbox}
<div class="mg_adminbox">
{select_adminbox}
</div>
{!endif}
</header>

<div class="mg_navbar" role="navigation" aria-label="Album navigation">

  {!if url_slideshow}
  <a class="button" href="{url_slideshow}"{slideshow_onclick}>{lang_slideshow}</a>
  {!endif}

  {!if edit_album}
  <a class="button" href="{url_edit}">{lang_edit}</a>
  {!endif}

  {!if top_pagination}
  <div class="mg_pagination">{top_pagination}</div>
  {!endif}

</div>

<div class="mg_table_scroll" role="region" aria-label="Media list" tabindex="0">
<table class="mg_mediaitems_table mg_filelist_table">
<tr>
  <th class="mg_filelist_thumb_col">&nbsp;</th>
  <th>{list_title}</th>
  <th>{list_desc}</th>
  <th>{list_size}</th>
  <th>{list_user}</th>
  <th>{list_updated}</th>
</tr>
<!-- BEGIN ImageRow -->
<!-- BEGIN ImageColumn -->
{CELL_DISPLAY_IMAGE}
<!-- END ImageColumn -->
<!-- END ImageRow -->
</table>
</div>

{!if lang_no_image}<div class="noitems">{lang_no_image}</div>{!endif}

<div class="mg_navbar" role="navigation" aria-label="Album navigation">
  <span>{album_id_display}</span><span class="mg_separator" style="">|</span><span>{page_number}</span>
  <div class="mg_pagination">{bottom_pagination}</div>
</div>
<div class="mg_jumpbox">{jumpbox}</div>
<div class="mg_sortbox">{select_sortbox}</div>
