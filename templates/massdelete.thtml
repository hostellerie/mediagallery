<form name="galselect" method="post" action="{s_form_action}" class="uk-form">
<div class="pluginRow1" style="padding:10px;line-height:2em">
{album_list}
</div>
<div class="mg_submit">
  <input type="submit" name="mode" value="{lang_delete}" data-confirm="{lang_delete_confirm}" onclick="return confirm(this.getAttribute('data-confirm'));"{xhtml}>
  <input type="submit" name="mode" value="{lang_cancel}"{xhtml}>
</div>
</form>
