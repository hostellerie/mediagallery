              {!endif}
              <option value="5">{lang_embed}</option>
            </select>
        </dd>

        <dt><label for="mg-remote-thumbnail-4">{lang_thumbnail}</label></dt>
        <dd><input type="file" id="mg-remote-thumbnail-4" name="thumbnail[]"{xhtml}></dd>

        <dt><label for="mg-remote-url-4">{lang_remote_url}</label></dt>
        <dd><textarea id="mg-remote-url-4" name="remoteurl[]" cols="60" rows="2" class="size6"></textarea></dd>

        <dt><label for="mg-remote-width-4">{lang_width}</label></dt>
        <dd><input type="text" id="mg-remote-width-4" name="width[]" size="3"{xhtml}></dd>

        <dt><label for="mg-remote-height-4">{lang_height}</label></dt>
        <dd><input type="text" id="mg-remote-height-4" name="height[]" size="3"{xhtml}></dd>

        <dt><label for="mg-remote-caption-4">{lang_caption}</label></dt>
        <dd><input type="text" id="mg-remote-caption-4" name="caption[]" class="size6" value=""{xhtml}></dd>

        <dt><label for="mg-remote-description-4">{lang_description}</label></dt>
        <dd><textarea id="mg-remote-description-4" name="description[]" cols="60" rows="2" class="size6"></textarea></dd>

        <dt><label for="mg-remote-keywords-4">{lang_keywords}</label></dt>
        <dd><input type="text" id="mg-remote-keywords-4" name="keywords[]" class="size6" value=""{xhtml}></dd>

        <dt><label>{lang_category}</label></dt>
        <dd>{cat_select}</dd>
      </dl>
    </fieldset>

    <div class="mg_submit">
      <input type="submit" value="{lang_save}" name="mode" class="submit"{xhtml}>
      <input type="submit" value="{lang_cancel}" name="mode" class="submit"{xhtml}>
      <input type="hidden" name="action" value="{action}"{xhtml}>
    </div>
  </div>
</form>

<script type="text/javascript">
formControl();
</script>
{end_block}
