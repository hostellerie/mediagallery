{start_block}
{navbar}
<script type="text/javascript">
function formControl(){
    var remoteType = '';
    var width      = '';
    var height     = '';

    for (i=0; i < document.remoteupload.elements['type[]'].length; i++) {
        if ( document.remoteupload.elements['type[]'][i].value == "-1" ||  document.remoteupload.elements['type[]'][i].value == "5") {
            document.remoteupload.elements['height[]'][i].disabled = true;
            document.remoteupload.elements['width[]'][i].disabled = true;
        } else {
            document.remoteupload.elements['height[]'][i].disabled = false;
            document.remoteupload.elements['width[]'][i].disabled = false;
        }
    }
}
</script>

<p>{lang_remote_help}</p>
<form method="post" enctype="multipart/form-data" name="remoteupload" action="{s_form_action}" class="compact uk-form">
  <div>
    <input type="hidden" name="{gltoken_name}" value="{gltoken}"{xhtml}>
    <p><span style="font-weight:bold;">{lang_destination_album}</span>&nbsp;{album_select}</p>

    <fieldset>
      <legend>{lang_file_number}1</legend>
      <dl class="form_block">
        <dt><label for="mg-remote-type-1">{lang_remote_media_type}</label></dt>
        <dd><select id="mg-remote-type-1" name="type[]" onchange="formControl()">
              <option value="-1">------</option>
              <option value="0">{lang_flv_stream}</option>
              {!if enable_remote_images}
              <option value="4">{lang_jpg}</option>
              <option value="6">{lang_gif}</option>
              <option value="7">{lang_png}</option>
              <option value="8">{lang_bmp}</option>
              {!endif}
              <option value="5">{lang_embed}</option>
            </select>
        </dd>

        <dt><label for="mg-remote-thumbnail-1">{lang_thumbnail}</label></dt>
        <dd><input type="file" id="mg-remote-thumbnail-1" name="thumbnail[]"{xhtml}></dd>

        <dt><label for="mg-remote-url-1">{lang_remote_url}</label></dt>
        <dd><textarea id="mg-remote-url-1" name="remoteurl[]" cols="60" rows="2" class="size6"></textarea></dd>

        <dt><label for="mg-remote-width-1">{lang_width}</label></dt>
        <dd><input type="text" id="mg-remote-width-1" name="width[]" size="3"{xhtml}></dd>

        <dt><label for="mg-remote-height-1">{lang_height}</label></dt>
        <dd><input type="text" id="mg-remote-height-1" name="height[]" size="3"{xhtml}></dd>

        <dt><label for="mg-remote-caption-1">{lang_caption}</label></dt>
        <dd><input type="text" id="mg-remote-caption-1" name="caption[]" class="size6" value=""{xhtml}></dd>

        <dt><label for="mg-remote-description-1">{lang_description}</label></dt>
        <dd><textarea id="mg-remote-description-1" name="description[]" cols="60" rows="2" class="size6"></textarea></dd>

        <dt><label for="mg-remote-keywords-1">{lang_keywords}</label></dt>
        <dd><input type="text" id="mg-remote-keywords-1" name="keywords[]" class="size6" value=""{xhtml}></dd>

        <dt><label>{lang_category}</label></dt>
        <dd>{cat_select}</dd>
      </dl>
    </fieldset>

    <fieldset>
      <legend>{lang_file_number}2</legend>
      <dl class="form_block">
        <dt><label for="mg-remote-type-2">{lang_remote_media_type}</label></dt>
        <dd><select id="mg-remote-type-2" name="type[]" onchange="formControl()">
              <option value="-1">------</option>
              <option value="0">{lang_flv_stream}</option>
              {!if enable_remote_images}
              <option value="4">{lang_jpg}</option>
              <option value="6">{lang_gif}</option>
              <option value="7">{lang_png}</option>
              <option value="8">{lang_bmp}</option>
              {!endif}
              <option value="5">{lang_embed}</option>
            </select>
        </dd>

        <dt><label for="mg-remote-thumbnail-2">{lang_thumbnail}</label></dt>
        <dd><input type="file" id="mg-remote-thumbnail-2" name="thumbnail[]"{xhtml}></dd>

        <dt><label for="mg-remote-url-2">{lang_remote_url}</label></dt>
        <dd><textarea id="mg-remote-url-2" name="remoteurl[]" cols="60" rows="2" class="size6"></textarea></dd>

        <dt><label for="mg-remote-width-2">{lang_width}</label></dt>
        <dd><input type="text" id="mg-remote-width-2" name="width[]" size="3"{xhtml}></dd>

        <dt><label for="mg-remote-height-2">{lang_height}</label></dt>
        <dd><input type="text" id="mg-remote-height-2" name="height[]" size="3"{xhtml}></dd>

        <dt><label for="mg-remote-caption-2">{lang_caption}</label></dt>
        <dd><input type="text" id="mg-remote-caption-2" name="caption[]" class="size6" value=""{xhtml}></dd>

        <dt><label for="mg-remote-description-2">{lang_description}</label></dt>
        <dd><textarea id="mg-remote-description-2" name="description[]" cols="60" rows="2" class="size6"></textarea></dd>

        <dt><label for="mg-remote-keywords-2">{lang_keywords}</label></dt>
        <dd><input type="text" id="mg-remote-keywords-2" name="keywords[]" class="size6" value=""{xhtml}></dd>

        <dt><label>{lang_category}</label></dt>
        <dd>{cat_select}</dd>
      </dl>
    </fieldset>

    <fieldset>
      <legend>{lang_file_number}3</legend>
      <dl class="form_block">
        <dt><label for="mg-remote-type-3">{lang_remote_media_type}</label></dt>
        <dd><select id="mg-remote-type-3" name="type[]" onchange="formControl()">
              <option value="-1">------</option>
              <option value="0">{lang_flv_stream}</option>
              {!if enable_remote_images}
              <option value="4">{lang_jpg}</option>
              <option value="6">{lang_gif}</option>
              <option value="7">{lang_png}</option>
              <option value="8">{lang_bmp}</option>
              {!endif}
              <option value="5">{lang_embed}</option>
            </select>
        </dd>

        <dt><label for="mg-remote-thumbnail-3">{lang_thumbnail}</label></dt>
        <dd><input type="file" id="mg-remote-thumbnail-3" name="thumbnail[]"{xhtml}></dd>

        <dt><label for="mg-remote-url-3">{lang_remote_url}</label></dt>
        <dd><textarea id="mg-remote-url-3" name="remoteurl[]" cols="60" rows="2" class="size6"></textarea></dd>

        <dt><label for="mg-remote-width-3">{lang_width}</label></dt>
        <dd><input type="text" id="mg-remote-width-3" name="width[]" size="3"{xhtml}></dd>

        <dt><label for="mg-remote-height-3">{lang_height}</label></dt>
        <dd><input type="text" id="mg-remote-height-3" name="height[]" size="3"{xhtml}></dd>

        <dt><label for="mg-remote-caption-3">{lang_caption}</label></dt>
        <dd><input type="text" id="mg-remote-caption-3" name="caption[]" class="size6" value=""{xhtml}></dd>

        <dt><label for="mg-remote-description-3">{lang_description}</label></dt>
        <dd><textarea id="mg-remote-description-3" name="description[]" cols="60" rows="2" class="size6"></textarea></dd>

        <dt><label for="mg-remote-keywords-3">{lang_keywords}</label></dt>
        <dd><input type="text" id="mg-remote-keywords-3" name="keywords[]" class="size6" value=""{xhtml}></dd>

        <dt><label>{lang_category}</label></dt>
        <dd>{cat_select}</dd>
      </dl>
    </fieldset>

    <fieldset>
      <legend>{lang_file_number}4</legend>
      <dl class="form_block">
