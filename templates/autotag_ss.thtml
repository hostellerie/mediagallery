<figure class="MG_autotag MG_autotag_slideshow MG_autotag_{align}" style="max-width:{framewidth}px;">
  <div id="slideshowContainer{ss_count}" class="slideshowContainer MG_autotag_slideshow_stage" style="max-width:{maxwidth}px;height:{maxheight}px;">
    {pics}
  </div>
  {!if caption}<figcaption class="MG_autotag_caption">{caption}</figcaption>{!endif}
</figure>
