<div class="mg-media-player mg-media-player-audio">
  <audio controls preload="metadata">
    <source src="{movie}" type="audio/mpeg">
    <p><a href="{movie}">{lang_download}</a></p>
  </audio>
  <div class="mg-media-audio-meta">
    <strong>{mp3_title}</strong><br{xhtml}>
    {lang_artist}: {mp3_artist}<br{xhtml}>
    {lang_album}: {mp3_album}
  </div>
</div>